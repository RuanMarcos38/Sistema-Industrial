generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String             @unique
  plan              String             @default("enterprise")
  status            String             @default("active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships       Membership[]
  organizations     Organization[]
  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  warehouses        Warehouse[]
  inventoryBalances InventoryBalance[]
  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]
  productionOrders  ProductionOrder[]
  receivables       Receivable[]
  payables          Payable[]
  employees         Employee[]
  shipments         Shipment[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Organization {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  legalName   String      @map("legal_name")
  tradeName   String      @map("trade_name")
  cnpj        String
  city        String
  state       String      @db.Char(2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]
  warehouses  Warehouse[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@map("organizations")
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  document  String
  email     String?
  phone     String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, document])
  @@index([tenantId, status])
  @@map("customers")
}

model Supplier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  document     String
  email        String?
  leadTimeDays Int      @default(7) @map("lead_time_days")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, document])
  @@index([tenantId, status])
  @@map("suppliers")
}

model Product {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  sku               String
  name              String
  category          String
  priceCents        Int                @default(0) @map("price_cents")
  costCents         Int                @default(0) @map("cost_cents")
  status            String             @default("active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBalances InventoryBalance[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@map("products")
}

model Warehouse {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  code              String
  name              String
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryBalances InventoryBalance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model InventoryBalance {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  warehouseId  String    @map("warehouse_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  reorderPoint Int       @default(0) @map("reorder_point")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("inventory_balances")
}

model SalesOrder {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  number       String
  customerName String   @map("customer_name")
  totalCents   Int      @map("total_cents")
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("sales_orders")
}

model PurchaseOrder {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       String
  supplierName String    @map("supplier_name")
  totalCents   Int       @map("total_cents")
  status       String    @default("open")
  expectedAt   DateTime? @map("expected_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model ProductionOrder {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  number      String
  productName String    @map("product_name")
  plannedQty  Int       @map("planned_qty")
  producedQty Int       @default(0) @map("produced_qty")
  status      String    @default("planned")
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("production_orders")
}

model Receivable {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  description String
  amountCents Int      @map("amount_cents")
  dueAt       DateTime @map("due_at") @db.Timestamptz(6)
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt])
  @@map("receivables")
}

model Payable {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  description String
  amountCents Int      @map("amount_cents")
  dueAt       DateTime @map("due_at") @db.Timestamptz(6)
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt])
  @@map("payables")
}

model Employee {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  registration   String
  name           String
  department     String
  position       String
  status         String       @default("active")
  hiredAt        DateTime     @map("hired_at") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registration])
  @@index([tenantId, status])
  @@map("employees")
}

model Shipment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String
  carrier      String
  destination  String
  status       String    @default("preparing")
  freightCents Int       @default(0) @map("freight_cents")
  eta          DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("shipments")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
